ted claim → misinformation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff5f5;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1058" y="725" width="452" height="90" as="geometry"/></mxCell><mxCell id="F4" value="F4 — SAFETY MISS&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Unsafe reply → privacy/security harm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff5f5;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="38" y="848" width="452" height="90" as="geometry"/></mxCell><mxCell id="F5" value="F5 — FEEDBACK IGNORED&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Unreviewed reports → repeat error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff5f5;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="548" y="848" width="452" height="90" as="geometry"/></mxCell><mxCell id="F6" value="F6 — OVERTRUST&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Advice mistaken as action → loss&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;fillColor=#fff5f5;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1058" y="848" width="452" height="90" as="geometry"/></mxCell><mxCell id="leg" value="COLOUR KEY: GREEN data/pipeline | BLUE model | ORANGE safety | PURPLE monitoring | GREY interface" style="text;html=1;align=left;fontSize=14;fontColor=#334155;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1550" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>